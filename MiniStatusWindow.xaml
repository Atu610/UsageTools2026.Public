<Window x:Class="UsageTools2026.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageTools2026.Public"
        Width="392"
        Height="168"
        MinWidth="392"
        MinHeight="168"
        MaxWidth="392"
        MaxHeight="168"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AnnouncementBanner"
                Margin="8,0,8,5"
                MaxHeight="66"
                Padding="10,7"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                CornerRadius="6"
                BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity="0.55" Color="#000000" />
            </Border.Effect>
            <DockPanel>
                <Button x:Name="DismissAnnouncementButton"
                        DockPanel.Dock="Right"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Margin="8,0,0,0"
                        Content="×"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="DismissAnnouncement_Click" />
                <TextBlock x:Name="AnnouncementText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="48"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border x:Name="RootBorder"
                Grid.Row="1"
                Height="96"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="#10151B"
                BorderBrush="#30414E"
                BorderThickness="1"
                Padding="8"
                MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="正常模式" Click="OpenMenu_Click" />
                    <MenuItem x:Name="ShowUsageMenuItem" Header="查看目前額度" Click="ShowCurrentUsage_Click" />
                    <MenuItem Header="Refresh" Click="RefreshMenu_Click" />
                    <MenuItem Header="Reset Position" Click="ResetPositionMenu_Click" />
                    <Separator />
                    <MenuItem Header="Quit" Click="QuitMenu_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button x:Name="RestoreButton"
                            DockPanel.Dock="Right"
                            Width="24"
                            Height="18"
                            Padding="0"
                            Margin="8,0,0,0"
                            Content="□"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#111111"
                            Background="#F2F2F2"
                            BorderBrush="#606060"
                            ToolTip="切回正常模式"
                            Click="OpenMenu_Click" />
                    <Button x:Name="MiniUpdateButton"
                            DockPanel.Dock="Right"
                            Width="18"
                            Height="18"
                            Padding="0"
                            Margin="5,0,0,0"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            ToolTip="&#x6709;&#x65B0;&#x7248;&#x672C;&#x53EF;&#x7528;"
                            AutomationProperties.Name="&#x4E0B;&#x8F09;&#x66F4;&#x65B0;"
                            Click="MiniUpdate_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="MiniUpdateCircle"
                                        CornerRadius="9"
                                        Background="#2F7CF6"
                                        BorderBrush="#7BB3FF"
                                        BorderThickness="1">
                                    <Path Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          Stroke="White"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 8,2 L 8,9 M 5,6 L 8,9 L 11,6 M 3,12 L 13,12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="MiniUpdateCircle" Property="Background" Value="#4A91FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MiniWorkButton"
                            DockPanel.Dock="Right"
                            Width="58"
                            Height="18"
                            Padding="2,0"
                            Margin="6,0,0,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="MiniWork_Click" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MiniProviderIconButton" Width="20" Height="20" Padding="0" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="訂閱方案" Click="MiniProviderPlan_Click">
                            <Border x:Name="MiniProviderIconBadge" Width="20" Height="20" CornerRadius="5" BorderThickness="1">
                                <TextBlock x:Name="MiniProviderBadgeText" Text="CX" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding BorderBrush, ElementName=MiniProviderIconBadge}" />
                            </Border>
                        </Button>
                        <TextBlock x:Name="ProviderTitleText" Text="Codex" FontSize="13" FontWeight="Bold" Foreground="#4F9DF7" VerticalAlignment="Center" />
                        <Ellipse x:Name="StatusLight" Width="9" Height="9" Margin="7,1,0,0" VerticalAlignment="Center" />
                        <Border x:Name="MiniFableBadge" Width="52" Height="16" Margin="7,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="4"
                                Background="#151B22" BorderBrush="#30414E" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="MiniFableFill" Height="2.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="MiniFableText" Text="Fable" FontSize="8.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="MiniResetCreditButton"
                                      Width="44"
                                      Height="18"
                                      Margin="7,0,0,0"
                                      Padding="2,0"
                                      Content="↻ 0"
                                      FontSize="10"
                                      FontWeight="Bold"
                                      Cursor="Hand"
                                      Visibility="Collapsed"
                                      ToolTip="Codex 重置額度"
                                      Click="MiniResetCredit_Click" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="PrimaryWindowPanel" Grid.Column="0">
                        <TextBlock>
                            <Run x:Name="FiveHourLabelRun" Text="5h " Foreground="#AEB8C1" FontWeight="Bold" />
                            <Run x:Name="FiveHourRun" Text="0% used" FontWeight="Bold" />
                        </TextBlock>
                        <ProgressBar x:Name="FiveHourBar" Height="5" Margin="0,2,0,0" Minimum="0" Maximum="100" Background="#27313A" />
                    </StackPanel>
                    <StackPanel x:Name="SecondaryWindowPanel" Grid.Column="2">
                        <TextBlock>
                            <Run x:Name="SevenDayLabelRun" Text="7d " Foreground="#AEB8C1" FontWeight="Bold" />
                            <Run x:Name="SevenDayRun" Text="0% used" FontWeight="Bold" />
                        </TextBlock>
                        <ProgressBar x:Name="SevenDayBar" Height="5" Margin="0,2,0,0" Minimum="0" Maximum="100" Background="#27313A" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="CacheStatusText" Grid.Row="2" Margin="0,3,0,0" FontSize="10" Foreground="#FFBD59" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SystemText" Grid.Row="3" Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#7F8A92" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Popup x:Name="MiniWorkPopup"
               PlacementTarget="{Binding ElementName=MiniWorkButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               Closed="MiniWorkPopup_Closed">
            <Border x:Name="MiniWorkPopupBorder"
                    Width="320"
                    Padding="11"
                    Margin="0,4"
                    CornerRadius="8"
                    Background="#151B22"
                    BorderBrush="#30414E"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="MiniWorkPopupTitle" FontSize="11" FontWeight="Bold" Foreground="#7F8A92" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MiniWorkRingHost" Width="38" Height="38" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MiniWorkNameText" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="34" />
                            <TextBlock x:Name="MiniWorkContextText" Margin="0,3,0,0" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniWorkModelText" Margin="0,2,0,0" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MiniResetCreditPopup"
               PlacementTarget="{Binding ElementName=MiniResetCreditButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               Closed="MiniResetCreditPopup_Closed">
            <Border x:Name="MiniResetCreditPopupBorder"
                    Width="286"
                    Padding="10"
                    Margin="0,4"
                    CornerRadius="8"
                    Background="#151B22"
                    BorderBrush="#30414E"
                    BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="MiniResetCreditHeader"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="MiniResetCreditSyncText"
                                   DockPanel.Dock="Right"
                                   FontSize="9" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="210"
                                  Margin="0,7,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MiniResetCreditList" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MiniPlanPopup"
               PlacementTarget="{Binding ElementName=MiniProviderIconButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border x:Name="MiniPlanPopupBorder" Width="205" Padding="10" Margin="0,4"
                    CornerRadius="8" Background="#151B22" BorderBrush="#30414E" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="MiniPlanPopupTitle" FontSize="11" FontWeight="Bold" />
                    <StackPanel x:Name="MiniPlanList" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
