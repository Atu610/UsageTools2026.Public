<Window x:Class="UsageTools2026.AiChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 更新資訊"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AAAB5" />
            <Setter Property="Background" Value="#17222C" />
            <Setter Property="BorderBrush" Value="#344551" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#243746" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#20303C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10"
            Background="#111820"
            BorderBrush="#3A4A58"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0"
                    Background="#17222C"
                    BorderBrush="#2D3D49"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Width="30"
                            Height="28"
                            Content="X"
                            Foreground="#EAF2F7"
                            Background="#24323E"
                            BorderBrush="#526574"
                            Click="Close_Click" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            MinWidth="72"
                            Height="28"
                            Content="重新整理"
                            Foreground="#EAF2F7"
                            Background="#24323E"
                            BorderBrush="#526574"
                            Click="Refresh_Click" />
                    <Button x:Name="TranslateButton"
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            MinWidth="56"
                            Height="28"
                            Content="中譯"
                            Foreground="#EAF2F7"
                            Background="#24323E"
                            BorderBrush="#526574"
                            ToolTip="將公開更新標題與摘要翻譯成繁體中文"
                            Click="Translate_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI 更新資訊"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F3F7FA" />
                        <TextBlock Text="Codex 與 Claude Code 版本摘要"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#91A3B0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="ProviderTabs"
                        Grid.Row="1"
                        Margin="16,14,16,10"
                        Background="#111820"
                        BorderBrush="#344551"
                        Foreground="#EAF2F7"
                        SelectionChanged="ProviderTabs_SelectionChanged">
                <TabItem x:Name="CodexTab" Header="Codex">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CodexReleaseList" Margin="12" />
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ClaudeTab" Header="Claude Code">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ClaudeReleaseList" Margin="12" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Padding="16,0"
                    Background="#0E141A"
                    BorderBrush="#2D3D49"
                    BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right"
                            Margin="10,0,0,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Background="#3A2B12"
                            BorderBrush="#9A742E"
                            BorderThickness="1">
                        <TextBlock x:Name="OfflineBadgeText"
                                   Text="資料來源"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FFD37A" />
                    </Border>
                    <TextBlock x:Name="SourceText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#91A3B0"
                               FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
