<Window x:Class="UsageTools2026.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About UsageTools2026"
        Width="500"
        MinWidth="500"
        MaxWidth="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{DynamicResource ShellBrush}"
            BorderBrush="{DynamicResource OuterBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WindowTitleText"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Width="28"
                            Height="26"
                            HorizontalAlignment="Right"
                            Content="X"
                            Style="{StaticResource DialogButtonStyle}"
                            Padding="0"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="CX" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CodexAccentBrush}" />
                        </Border>
                        <Border Width="42" Height="42" CornerRadius="6" Margin="7,0,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="CC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ClaudeAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProductTitleText" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="ProductSubtitleText" Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DescriptionText"
                           Grid.Row="1"
                           Margin="0,14,0,0"
                           FontSize="12"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />

                <Border Grid.Row="2" Height="1" Margin="0,13,0,12" Background="{DynamicResource BorderBrush}" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="AuthorLabelText" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="AuthorValueText" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="AiLabelText" Grid.Row="1" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="AiValueText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="PlatformLabelText" Grid.Row="2" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="PlatformValueText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <TextBlock x:Name="CopyrightText" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Width="76" HorizontalAlignment="Right" Style="{StaticResource DialogButtonStyle}" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
